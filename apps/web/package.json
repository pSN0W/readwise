{
  "name": "@rh/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reading helper: laptop web app over the library folder.",
  "scripts": {
    "predev": "node scripts/scratch.ts",
    "dev": "vite --port 5173 --strictPort --host 127.0.0.1",
    "build": "vite build",
    "start": "node server/index.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "synth": "node scripts/gen-synthetic.ts",
    "perf": "node scripts/perf.ts"
  },
  "engines": {
    "node": ">=23.6"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@playwright/test": "1.63",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.3",
    "dompurify": "^3.4.16",
    "katex": "^0.18.9",
    "marked": "^18.0.14",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
