{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "skipLibCheck": true,
    "paths": { "@rh/core": ["../../packages/core/src/index.ts"] }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "server/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "e2e/**/*.ts", "vite.config.ts", "playwright.config.ts"]
}
