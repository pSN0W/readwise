{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reading-helper.local/schemas/cards.schema.json",
  "title": "cards",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^c_[A-Za-z0-9_]+$"
          },
          "rev": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "what": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "how": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "string",
            "minLength": 1
          },
          "extra": {
            "type": "string",
            "minLength": 1
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[^/]+(/[^/]+){0,2}$",
              "description": "Topic path, up to 3 levels joined by /"
            }
          },
          "refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "pattern": "^s_[a-z0-9_]+$"
                },
                "start": {
                  "type": "integer",
                  "minimum": 1
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "source",
                "start",
                "end"
              ],
              "additionalProperties": false
            }
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "rev",
          "title",
          "topics",
          "refs",
          "images",
          "created_at",
          "updated_at"
        ],
        "additionalProperties": false
      }
    },
    "retired": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^c_[A-Za-z0-9_]+$"
          },
          "into": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^c_[A-Za-z0-9_]+$"
            }
          }
        },
        "required": [
          "id",
          "into"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "generation",
    "cards",
    "retired"
  ],
  "additionalProperties": false
}