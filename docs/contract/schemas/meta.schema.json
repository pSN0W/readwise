{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reading-helper.local/schemas/meta.schema.json",
  "title": "meta",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^s_[a-z0-9_]+$"
    },
    "kind": {
      "enum": [
        "pdf",
        "blog",
        "video",
        "markdown"
      ]
    },
    "title": {
      "type": "string"
    },
    "original": {
      "type": "string",
      "description": "file name of the ground-truth original inside the source folder"
    },
    "original_extra": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "other ground-truth files, e.g. subtitles"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "n_lines": {
      "type": "integer",
      "minimum": 0
    },
    "toc": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "line": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "title",
          "level",
          "line"
        ],
        "additionalProperties": false
      }
    },
    "pages": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "number",
                "minimum": 0
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "[start_line, page] runs sorted by line (pdf)"
    },
    "times": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "number",
                "minimum": 0
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "[line, seconds] sorted by line (video)"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "caption": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "figure",
              "slide",
              "image"
            ]
          },
          "time_s": {
            "type": "number"
          }
        },
        "required": [
          "path",
          "line",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "content_bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "size of content.md in bytes (UTF-8)"
    },
    "anchor_step": {
      "type": "integer",
      "minimum": 1,
      "description": "an anchor every this many lines"
    },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "description": "[line, byte] pairs: byte offset (UTF-8) where that line starts in content.md. First entry is [1, 0]. Sorted.",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "integer",
            "minimum": 1
          },
          {
            "type": "integer",
            "minimum": 0
          }
        ],
        "minItems": 2,
        "maxItems": 2
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "kind",
    "title",
    "original",
    "content_sha256",
    "n_lines",
    "toc",
    "pages",
    "times",
    "assets",
    "content_bytes",
    "anchor_step",
    "anchors"
  ],
  "additionalProperties": false
}